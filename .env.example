GROQ_API_KEY=your_groq_api_key_here
# Groq chat model used for answers and query rewriting
GROQ_MODEL=openai/gpt-oss-120b
JWT_SECRET_KEY=finsolve-secret-key-change-in-production
JWT_EXPIRE_MINUTES=30
CHROMA_DB_PATH=./chroma_db
RESOURCES_PATH=./resources

# --- Redis Stack Semantic Cache ---
# Connection URL for Redis Stack (needs the RediSearch module for vector search)
REDIS_URL=redis://localhost:6379
# Seconds a cached answer lives before Redis expires it
CACHE_TTL=3600
# Minimum cosine similarity (0-1) between questions to count as a cache hit
CACHE_SIMILARITY_THRESHOLD=0.92
# Set to false to bypass the semantic cache entirely
CACHE_ENABLED=true

# --- Retrieval ---
# Chunks fetched from ChromaDB per collection by dense (vector) search
DENSE_TOP_K=15
# Chunks fetched per collection by BM25 keyword search (hybrid collections only)
BM25_TOP_K=15
# RRF smoothing constant k in score = 1 / (k + rank)
RRF_K=60
# Number of fused candidates kept after Reciprocal Rank Fusion
RRF_CANDIDATE_COUNT=15

# --- Reranker ---
# Hugging Face cross-encoder model used to rerank candidates (English, ~90 MB)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Number of candidates passed into the cross-encoder
RERANKER_CANDIDATE_COUNT=15
# Number of top reranked chunks sent to the LLM as context
RERANKER_FINAL_TOP_K=6
# Chunks scoring below this cross-encoder score (sigmoid, 0-1) are discarded
RERANKER_SCORE_THRESHOLD=0.1

# --- Conversation ---
# Number of recent messages (user + assistant) kept as conversation history
CONVERSATION_HISTORY_LENGTH=6
# Set to false to disable LLM rewriting of context-dependent follow-up questions
QUERY_REWRITING_ENABLED=true

# --- Cache versioning ---
# Bump (e.g. v2) to invalidate every cached response after retrieval changes
RETRIEVAL_VERSION=v2

# --- Langfuse tracing (optional) ---
# Tracing is off until both keys are set. Keys: Langfuse project > Settings > API Keys.
# Langfuse Cloud (https://cloud.langfuse.com) or a self-hosted instance.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# EU cloud shown; US is https://us.cloud.langfuse.com, or your self-hosted URL
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Separates traces by deployment in the Langfuse UI (production, staging, development)
# LANGFUSE_TRACING_ENVIRONMENT=production
# Version label shown on traces, e.g. a git commit or release tag
# LANGFUSE_RELEASE=
# Fraction of requests to trace (0.0-1.0)
# LANGFUSE_SAMPLE_RATE=1.0
# Set to false to switch tracing off without removing the keys
# LANGFUSE_TRACING_ENABLED=true
# Send questions, answers, prompts and document text to Langfuse. Leave false unless
# Langfuse is self-hosted or you accept this data leaving your environment: the app
# serves HR and finance records. Secrets and e-mail addresses are scrubbed either way.
# LANGFUSE_CAPTURE_CONTENT=false

# --- RAGAS judge for evaluation/evaluate_answers.py (optional; the app itself never uses it) ---
# Claude Haiku scores the answers. Needed only to run the answer-quality evaluation; it is passed
# to that CI step as the ANTHROPIC_API_KEY repository secret.
# ANTHROPIC_API_KEY=sk-ant-...
# EVAL_JUDGE_MODEL=claude-haiku-5-5
